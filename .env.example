GCP_PROJECT_ID=your-gcp-project-id
CHAT_HISTORY_DATASET=intentra_chat_history
CHAT_HISTORY_TABLE=conversation_turns
CHAT_HISTORY_LOCATION=US
HEALTH_UNDERWRITING_DATASET=intentra_health_underwriting
HEALTH_UNDERWRITING_LOCATION=US
VERTEX_AI_LOCATION=global
UNDERWRITING_GEMINI_MODEL=gemini-3.5-flash-lite

