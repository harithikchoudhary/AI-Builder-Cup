DOCUMENT_AI_PROCESSOR=projects/your-project/locations/us/processors/your-processor-id
UNDERWRITING_DOCUMENT_BUCKET=your-private-underwriting-documents-bucket
UNDERWRITING_POLICY_BUCKET=your-private-underwriting-policy-sources-bucket
